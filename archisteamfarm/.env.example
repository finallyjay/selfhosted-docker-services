# Local domain to access ArchiSteamFarm web UI
ARCHISTEAMFARM_LOCAL_DOMAIN=archisteamfarm.mydomain.local

# Personal ASF encryption key (passed to ASF as ASF_CRYPTKEY).
# Encrypts SteamPassword (PasswordFormat 1, AES) and salts IPCPassword hashes.
# Changing it requires re-encrypting every bot password and the IPC hash.
# Left empty on purpose: the deploy fails until a real key is set.
ARCHISTEAMFARM_CRYPTKEY=
