# Container hostname (Plex uses it as the default server name)
PLEX_HOSTNAME=plex

# Plex local IP
PLEX_LOCAL_IP=x.x.x.x

# Optional: claim token from https://www.plex.tv/claim, only for the first
# setup (it expires after 4 minutes). Leave empty afterwards.
PLEX_CLAIM=

# Host path where the media folders (movies, music, tv-series...) are mounted
PLEX_MOUNTED_DATA=/path/to/plex/mounted/data

# Local domain to access Plex
PLEX_LOCAL_DOMAIN=plex.mydomain.local
