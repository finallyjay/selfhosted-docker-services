# Host port mapped to the container's 5678
N8N_PORT=5678

# Timezone (e.g., Europe/Madrid)
TZ=Etc/UTC

# Public hostname and protocol used by n8n for URLs and cookies
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true

# Public base URL used in webhook URLs (with a trailing slash)
N8N_WEBHOOK_URL=https://n8n.example.com/

# Optional: JSON list of disabled nodes. Leave unset to keep n8n's defaults
# (Execute Command and Local File Trigger disabled). To allow Execute Command:
# N8N_NODES_EXCLUDE=["n8n-nodes-base.localFileTrigger"]

# Encryption key for stored credentials (generate a strong random value)
N8N_ENCRYPTION_KEY=replace_me_with_a_long_random_string

# Optional: fine-grained GitHub token (Contents: Read-only, all repositories)
# used by workflows that back up repositories with "git clone --mirror"
N8N_GITHUB_BACKUP_TOKEN=
