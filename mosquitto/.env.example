# Host port mapped to the container's 1883 (MQTT). Keep 1883 unless it clashes;
# the robot and Home Assistant both connect to <HOST_LAN_IP>:this port.
MOSQUITTO_PORT=1883

# MQTT credentials. Used by Home Assistant's MQTT integration and by Congatudo
# on the robot. The password is required (deploy fails if empty).
MOSQUITTO_USERNAME=homeassistant
MOSQUITTO_PASSWORD=

# Timezone (e.g., Europe/Madrid)
TZ=Europe/Madrid
