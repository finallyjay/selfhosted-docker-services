# Address the S3 API listens on (e.g. the host's Tailscale IP)
GARAGE_S3_BIND_ADDRESS=100.64.0.1

# Metadata (LMDB) must be on a local disk; data and snapshots can be on a NAS mount
GARAGE_META_DATA=/var/lib/garage-meta
GARAGE_DATA=/mnt/nas/garage/data
GARAGE_SNAPSHOTS_DATA=/mnt/nas/garage/snapshots

# Secrets. Left empty on purpose: the deploy fails until they are set.
# GARAGE_RPC_SECRET: openssl rand -hex 32
# GARAGE_ADMIN_TOKEN and GARAGE_METRICS_TOKEN: openssl rand -base64 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=
