# Peer port for incoming connections (TCP and UDP). Forward it on the router
# to this host.
QBITTORRENT_PEER_PORT=16881

# Media library (movies, tv-series, music...) mounted read-write from the NAS
QBITTORRENT_MEDIA_DATA=/path/to/media

# General downloads folder, mounted read-write from the NAS
QBITTORRENT_DOWNLOADS_DATA=/path/to/downloads

# Local folder (ideally on SSD) for downloads in progress
QBITTORRENT_INCOMPLETE_DATA=/path/to/incomplete

# Local domain of the web UI
QBITTORRENT_LOCAL_DOMAIN=torrents.mydomain.local
