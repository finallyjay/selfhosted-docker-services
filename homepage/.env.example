# Base path for persistent Homepage data
HOMEPAGE_DATA=/path/to/homepage/data

# Allowed hosts to access Homepage
HOMEPAGE_ALLOWED_HOSTS=homepage.mydomain.local

# Widget secrets, used in the config files as {{HOMEPAGE_VAR_NAME}}.
# Every HOMEPAGE_VAR_* variable in this file reaches the container.
HOMEPAGE_VAR_PIHOLE_MAIN_KEY=
HOMEPAGE_VAR_PIHOLE_RPI_KEY=
